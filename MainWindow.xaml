<Window x:Class="IDEaHTest1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IDEaHTest1"
        xmlns:userControls="clr-namespace:IDEaHTest1.Custom.UserControl"
        mc:Ignorable="d"
        Title="MainWindow" Height="720" Width="1280"
        WindowStyle="None" 
        ResizeMode="CanResize"
        >

    <!-- To make my window borderless to have my own panel 
        to look cool but also to make it resizable 
        because ResizeMode doesn't work without it
    -->

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0"
              UseAeroCaptionButtons="False"
              ResizeBorderThickness="6"
              CaptionHeight="0"/>
    </WindowChrome.WindowChrome>


    <!-- To avoid copy-paste in my code: Just like functions/constants but for style -->
    <Window.Resources>
        <Style TargetType="MenuItem" x:Key="SubMenuItem">
            <Setter Property="Foreground" Value="Black"></Setter>
        </Style>

        <Style TargetType="TreeViewItem" x:Key="TreeViewItem">
            <Setter Property="Foreground" Value="#FFF0F0F0"></Setter>
        </Style>

        <Style TargetType="TextBox" x:Key="TextBox">
            <Setter Property="Foreground" Value="#FFF0F0F0"></Setter>
            <Setter Property="Background" Value="#FF3F4250"></Setter>
        </Style>

    </Window.Resources>

    <Grid Background="#FF272932">

        <Grid.RowDefinitions>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition Height="22"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <Rectangle Name="TitleBar"  Grid.Row="0" Fill="#3f4250" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"></Rectangle>

        <!-- Title bar and the basic three buttons of every window: 
            Minimize, Maximize and Close 
        -->

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="MinWinBtn" Content="---" Height="31" Click="MinimizeWindow" Width="47" BorderBrush="#FF3F4250" Background="#FF3F4250" Foreground="#FFF0F0F0"/>
            <Button x:Name="MaxWinBtn" Content="□" Height="31" Click="MaximizeWindow" Width="47" BorderBrush="#FF3F4250" Background="#FF3F4250" Foreground="#FFF0F0F0" RenderTransformOrigin="0.5,0.5">
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform AngleY="0.168"/>
                        <RotateTransform/>
                        <TranslateTransform Y="0.053"/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>
            <Button x:Name="CloseWinBtn" Content="X" Height="31" Click="CloseWindow" Width="47" BorderBrush="#FFCC2936" Background="#FFCC2936" Foreground="#FFF0F0F0"/>
        </StackPanel>

        <!-- Menu Bar -->

        <Menu x:Name="Menu" Grid.Row="1" Background="#FF555867" Foreground="#FFF0F0F0" FontSize="14">
            <MenuItem Header="File">
                <MenuItem Header="New File" Style="{StaticResource SubMenuItem}" Click="CreateNewFile"></MenuItem>
                <MenuItem Header="Open File" Style="{StaticResource SubMenuItem}" Click="OpenFile"></MenuItem>
                <MenuItem Header="Open Folder" Style="{StaticResource SubMenuItem}"></MenuItem>
                <MenuItem Header="Save File" Style="{StaticResource SubMenuItem}" Click="SaveFile"></MenuItem>
                <MenuItem Header="Save All" Style="{StaticResource SubMenuItem}"></MenuItem>
                <Separator></Separator>
                <MenuItem Header="Exit" Style="{StaticResource SubMenuItem}"></MenuItem>
            </MenuItem>
            <MenuItem Header="View"></MenuItem>
            <MenuItem Header="Edit"></MenuItem>
            <MenuItem Header="Help"></MenuItem>
        </Menu>

        <!-- File Manager and The Text Editor itself -->

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"></ColumnDefinition>
                <ColumnDefinition Width="5"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <!-- File manager - You can search the files -->

            <!--<TreeView Grid.Column="0" BorderBrush="{x:Null}" Background="#FF373A4C" Foreground="#FFF0F0F0">
                <TreeViewItem Header="Head" Style="{StaticResource TreeViewItem}">
                    <TreeViewItem>
                        
                    </TreeViewItem>
                </TreeViewItem>
            </TreeView>-->

            <!--<Rectangle Grid.Column="0" Fill="#373a4c"></Rectangle>-->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#FF3F4250" />

            <TextBox x:Name="textEditor" Grid.Column="2" 
                     TextWrapping="Wrap" 
                     FontSize="20" 
                     AcceptsReturn="True" 
                     AcceptsTab="True"
                     Style="{StaticResource TextBox}" BorderBrush="{x:Null}" Margin="0,35,0,0"
                     IsEnabled="False" TextChanged="textEditor_TextChanged"
                     />

            <Rectangle Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="28" Fill="#FF555867"></Rectangle>

            <!-- Tabs of the files you working with -->

            <StackPanel x:Name="Tabs" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                
            </StackPanel>

        </Grid>

    </Grid>
</Window>
